{
  "require": {
    "iodigital-com/php-code-sniffer-standard": "^29.5",
    "squizlabs/php_codesniffer": "^3.13.6"
  },
  "repositories": {
    "iodigital-com/php-code-sniffer-standard": {
      "type": "path",
      "url": "../../"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}

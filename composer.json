{
    "name": "iodigital-com/php-code-sniffer-baseliner",
    "description": "IO PHP Code Sniffer Baseliner",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "IODigital\\CodeSnifferBaseliner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IODigital\\CodeSnifferBaseliner\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpcs-baseliner"
    ],
    "require-dev": {
        "iodigital-com/php-code-sniffer-standard": "^29.5",
        "phpcompatibility/php-compatibility": "^10.0.0@dev",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "slevomat/coding-standard": "^8.22",
        "phpunit/phpunit": "^11.5"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
